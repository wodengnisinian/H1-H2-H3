+            perseed[s]['diagnostics']=diagnostics([r for rs in allrows.values() for r in rs if r['seed']==s],args.round)
+        fresh=aggregate['fresh']; main=fresh[primary]
+        check=(all(main['original_top1']-fresh[b]['original_top1']>=.05-1e-12 and
