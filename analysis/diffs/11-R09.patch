+"""Single protected H3 opening. Each stage is a separate process with explicit inputs."""
+from pathlib import Path
+from datetime import datetime,timezone
+from collections import Counter,defaultdict
+import argparse,gzip,hashlib,importlib,json,os,random,runpy,secrets,subprocess,sys
+import torch
+
+ROOT=Path(__file__).resolve().parents[1]
+SEEDS=(1701,2701,3701)
+KINDS=("relation_order","role_reversal","competing_chain")
+PROT=ROOT/"configs/research_protocol.json"
+WORDING=ROOT/"configs/formal_templates.json"
+def sha(p):
+    with p.open("rb") as f:return hashlib.file_digest(f,"sha256").hexdigest()
+def read(p):return json.loads(p.read_bytes())
+def write(p,x):
+    with p.open("x",encoding="utf-8") as f:
+        json.dump(x,f,ensure_ascii=False,indent=2,allow_nan=False);f.write("\n")
+def line(f,x):f.write(json.dumps(x,ensure_ascii=False,separators=(",",":"))+"\n")
+def rows(p):
+    with p.open(encoding="utf8") as f:
+        for s in f:yield json.loads(s)
+def now():return datetime.now(timezone.utc).isoformat()
+def load_local(a):
+    sys.path.insert(0,str(a.inputs/"prior/code"))
+    import model, data_views
+    return model,data_views
+
+def freeze(a):
+    if not read(a.candidate/"metrics.json")["development_gate"]["eligible"]:
+        raise ValueError("Pre-specified development screen failed")
+    if read(PROT)["formal"]["max_openings"]!=1:raise ValueError("Formal opening limit incorrect")
+    # The study-wide exclusive file is also a gate across new attempt directories.
+    lock=ROOT/"datasets"/"formal-attempt.json"
+    artifacts=[a.candidate/f"checkpoint-{s}.json" for s in SEEDS]
+    artifacts += [a.candidate/"metrics.json",PROT,WORDING,Path(__file__).resolve(),a.inputs/"prior/code/evaluate.py",a.inputs/"prior/code/model.py"]
+    artifacts += list((ROOT/"src").glob("*.py"))
+    artifacts += [a.inputs/"b13"/p for p in ("冻结清单.json","inputs/source/generate.py")]
+    srcs={str(p):sha(p) for p in artifacts}
+    entry={"utc":now(),"out":str(a.out),"module":a.module,"candidate":str(a.candidate),"sha256":srcs}
+    write(lock,entry)
+    write(a.out/"freeze.json",entry)
+    write(a.out/"entropy.json",{"hex":secrets.token_hex(32),"freeze_sha256":sha(a.out/"freeze.json")})
+def confirm(a):
+    entry=read(a.out/"freeze.json")
+    if not all(sha(Path(p))==h for p,h in entry["sha256"].items()):raise ValueError("Freeze mismatch")
+    if entry["module"]!=a.module or entry["candidate"]!=str(a.candidate):raise ValueError("Candidate mismatch")
+def draw(a):
+    confirm(a)
+    model,dv=load_local(a)
+    b13=a.inputs/"b13"; b=model.load_bundle(b13,1701)
+    gen=runpy.run_path(str(b13/"inputs/source/generate.py"))
+    styles=read(WORDING)
+    all_styles={s for l in styles.values() for s in l}
+    historical=set().union(*gen["QUESTION_FAMILIES"].values(),dv.FRESH_TEMPLATES,dv.PARAPHRASE,dv.QUARTET,
+        runpy.run_path(str(b13/"code/generate_cohort.py"))["TEMPLATES"])
+    from mech_data import NEW_TEMPLATES
+    historical.update(NEW_TEMPLATES)
+    for style in all_styles:
+        if style in historical or any(t not in b.vocab for t in style.split() if not t.startswith("{")):
+            raise ValueError("Invalid formal template or vocabulary")
+    def persons(r):return frozenset(w for h,_,t in r["nodes"] for w in (h,t))
+    blocked={persons(r) for r in rows(b13/"cohort/features.jsonl")}
+    blocked.update(persons(r) for r in rows(a.inputs/"prior/runs/本地开发-01/fresh_dev-输入.jsonl") if r["variant"]=="original")
+    # Re-read all candidate evaluation graphs when supplied, independently of the reserved range.
+    cp=a.candidate/"development-inputs.jsonl.gz"
+    if cp.is_file():
+        with gzip.open(cp,"rt",encoding="utf8") as f:
+            for s in f:
+                r=json.loads(s)
+                if r.get("variant")=="original" and "nodes" in r:blocked.add(persons(r))
+    rng=random.Random(int(read(a.out/"entropy.json")["hex"],16))
+    n=read(PROT)["formal"]["per_stratum"]
+    raw=[]
+    for ki,k in enumerate(KINDS):
+        pos=[(ki*n+i)%12 for i in range(n)];fam=[i%len(styles["original"]) for i in range(n)]
+        rng.shuffle(pos);rng.shuffle(fam)
+        for g,j in zip(pos,fam,strict=True):
+            while True:
+                idx=rng.randrange(70_000_000,gen["PERSON_SET_SPACE"])
+                people=frozenset(gen["ranked_people"](idx))
+                if people not in blocked:break
+            blocked.add(people)
+            doc=gen["document"](idx,k,g,styles["original"][j],rng)
+            if persons(doc)!=people:raise ValueError("Source index mismatch")
+            raw.append(doc)
+    rng.shuffle(raw)
+    root_view=dv.load_view(raw,b.trainer,b.evaluator)
+    views=dv.make_eval_views(root_view,styles["original"],b.evaluator,paraphrases=styles["para"],quartet=styles["quartet"])
+    with (a.out/"features.jsonl").open("x",encoding="utf8") as ff,(a.out/"labels.jsonl").open("x",encoding="utf8") as lf:
+        for var,(docs,gold) in views.items():
+            for d,g in zip(docs,gold,strict=True):
+                line(ff,dict(variant=var,doc_id=d.doc_id,stratum=d.stratum,question=d.question,nodes=d.nodes))
+                line(lf,dict(variant=var,doc_id=d.doc_id,gold=g))
+    write(a.out/"cohort.json",dict(features_sha256=sha(a.out/"features.jsonl"),labels_sha256=sha(a.out/"labels.jsonl"),
+         graphs=len(raw),per_stratum=n,utc=now(),quartet_graphs=len(views["q0"][0])))
+def predict(a):
+    confirm(a)
+    model,dv=load_local(a)
+    mod=importlib.import_module(a.module)
+    if sha(a.out/"features.jsonl")!=read(a.out/"cohort.json")["features_sha256"]:raise ValueError("Features changed")
+    manifest={}
+    for seed in SEEDS:
+        b=model.load_bundle(a.inputs/"b13",seed)
+        st=read(a.candidate/f"checkpoint-{seed}.json")
+        path=a.out/f"prediction-{seed}.jsonl"
+        with path.open("x",encoding="utf8") as f:
+            from itertools import batched
+            for batch in batched(rows(a.out/"features.jsonl"),128):
+                docs=[]
+                for r in batch:
+                    if set(r)!={"variant","doc_id","stratum","question","nodes"}:raise ValueError("Feature field mismatch")
+                    q=tuple(r["question"]);nodes=tuple(map(tuple,r["nodes"]))
+                    docs.append(b.trainer.Example(r["doc_id"],r["stratum"],q,nodes,b.trainer.lexical_candidates(q,nodes),None))
+                docs=b.evaluator.shortlist(docs,"direction")
+                feat=model.extract(b,docs)
+                with torch.no_grad():candidate=mod.predict(b,docs,st)
+                scores={"learned":candidate,"pool":feat.pooled,"direction":feat.base,"old":feat.old,
+                        "uniform":model.score(feat,torch.zeros(64))}
+                if not all(v.shape==(len(docs),2) and v.isfinite().all() for v in scores.values()):raise ValueError("Nonfinite scores")
+                for j,(d,row) in enumerate(zip(docs,batch)):
+                    choices={k:str(d.candidates[int(v[j].argmax())]) for k,v in scores.items()}
+                    choices["first"]=str(d.candidates[0])
+                    line(f,dict(graph_id=d.doc_id,seed=seed,kind=d.stratum,variant=row["variant"],
+                                candidates=list(map(str,d.candidates)),gate=bool(feat.active[j]),predictions=choices,
+                                logits={k:v[j].tolist() for k,v in scores.items()}))
+        manifest[path.name]=sha(path)
+    write(a.out/"prediction-seal.json",{"sha256":manifest,"utc":now(),"cohort":sha(a.out/"cohort.json")})
+def score(a):
+    confirm(a)
+    cohort=read(a.out/"cohort.json");seal=read(a.out/"prediction-seal.json")
+    if sha(a.out/"cohort.json")!=seal["cohort"] or not all(sha(a.out/k)==h for k,h in seal["sha256"].items()):
+        raise ValueError("Prediction seal mismatch")
+    write(a.out/"opening.json",{"utc":now(),"seal":sha(a.out/"prediction-seal.json")})
+    if sha(a.out/"labels.jsonl")!=cohort["labels_sha256"]:raise ValueError("Labels changed")
+    gold={(r["doc_id"],r["variant"]):r["gold"] for r in rows(a.out/"labels.jsonl")}
+    with (a.out/"scored-predictions.jsonl").open("x",encoding="utf8") as f:
+        for s in SEEDS:
+            for r in rows(a.out/f"prediction-{s}.jsonl"):
+                r["gold"]=str(gold[(r["graph_id"],r["variant"])]);line(f,r)
+    subprocess.run([sys.executable,"-B",str(a.inputs/"prior/code/evaluate.py"),str(a.out/"scored-predictions.jsonl"),str(a.out/"metrics.json")],check=True)
+if __name__=="__main__":
+    p=argparse.ArgumentParser(description=__doc__);p.add_argument("stage",choices=["all","draw","predict","score"]);p.add_argument("--module",required=True)
+    for key in ("inputs","candidate","out"):p.add_argument("--"+key,type=Path,required=True)
+    a=p.parse_args()
+    if a.stage=="all":
+        a.out.mkdir(parents=True,exist_ok=False);freeze(a)
+        for stage in ("draw","predict","score"):
+            subprocess.run([sys.executable,"-B",str(Path(__file__).resolve()),stage,*sys.argv[2:]],check=True)
+    else:{"draw":draw,"predict":predict,"score":score}[a.stage](a)
