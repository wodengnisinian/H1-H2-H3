+        pairs = [(primary, name) for name in ("first_mentioned", "uniform", "shuffled", "random", "one", "four", "soft_role")]
+        pairs += [("four", "one"), ("probe_four", "probe_one"), ("probe_one", "probe_one_shuffled_labels"),
