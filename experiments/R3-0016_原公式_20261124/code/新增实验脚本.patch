+
+
+def thresholds(summary):
+    summary["h1_pass"] = bool(summary["h1_accuracy"] >= .80 - 1e-12 and summary["h1_lcb95"] > 1e-12)
+    summary["h2_pass"] = bool(summary["h2_delta"] >= .02 - 1e-12 and summary["h2_lcb95"] > 1e-12)
+
