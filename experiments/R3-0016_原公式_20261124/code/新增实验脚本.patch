+                                semantic_reversal_flip=avg([preds[0] != preds[1], preds[2] != preds[3]]),
+                                semantic_reversal_both_correct=avg([hits[0] and hits[1], hits[2] and hits[3]]))
+                beh.append(list(base.values()))
